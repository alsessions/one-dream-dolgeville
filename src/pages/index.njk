---
layout: layouts/base.njk
title: Home
description: Sunoco Gas, Convenience Store, Full Kitchen
permalink: /index.html
---
{% from "_components/index.njk" import button, card, badge, accordion %}

{# Hero Section #}
<section class="home-hero section relative flex min-h-[520px] items-center overflow-hidden md:min-h-[680px]">
  <img
    src="/assets/images/interior.jpeg"
    alt="Inside One Dream with drink coolers, snacks, and store aisles"
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    sizes="100vw"
    eleventy:widths="640,960,1200"
  >
  <div class="absolute inset-0 bg-zinc-950/35" aria-hidden="true"></div>
  <div class="relative w-full px-6 text-center sm:px-8 lg:px-12">
    <div class="max-w-4xl mx-auto">
     

      <h1 class="text-balance text-white text-7xl">
        <span class="text-zinc-200">One Dream</span> 
      </h1>

     

      <div class="flex flex-wrap justify-center gap-4 mt-8">
        {{ button({
          text: "View Menu",
          url: "/menu/",
          variant: "primary",
          size: "lg"
        }) }}


      </div>
    </div>
  </div>
</section>

{# Specials Section #}
<section class="page-content section bg-zinc-950">
  <div class="mx-auto w-full px-6 sm:px-8 lg:px-12">
    <img
      src="/assets/images/specials.jpeg"
      alt="Family deal specials: Deal 1 includes 1 large pepperoni, 10 wings, fries and 2L soda for $39.99. Deal 2 includes 2 large pepperoni, 10 wings, fries and 2L soda for $59.99. Deal 3 includes 5 large cheese, pepperoni or chicken mix pizzas with large fries for $99.99."
      class="mx-auto w-full rounded-lg border border-red-950/80"
      loading="lazy"
      decoding="async"
      sizes="100vw"
      eleventy:widths="640,960,1200,1600,2048"
    >
  </div>
</section>

{# Features Section #}
<section class="page-content section bg-zinc-100 text-zinc-800">
  <div class="mx-auto w-full  px-6 sm:px-8 lg:px-20">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-5xl font-semibold text-zinc-950 md:text-7xl">One Stop</h2>
      <p class="mt-5 text-xl font-semibold leading-relaxed text-zinc-700">
        Fuel up, grab what you need, and bring home something hot from the kitchen. One Dream keeps the essentials simple, fast, and close to home.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {# Feature 1 #}
      <div class="rounded-lg border border-zinc-300 bg-zinc-50 p-8 shadow-sm">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg border border-zinc-300 bg-zinc-200 text-zinc-700">
            {% phosphor "gas-pump", "duotone", { size: 30 } %}
          </div>
          <h3 class="text-3xl font-semibold text-zinc-900">Sunoco Gas</h3>
        </div>
        <p class="text-lg leading-relaxed text-zinc-700">
          Stop in for dependable Sunoco fuel whenever the road calls. The pumps are ready 24 hours a day, whether you are commuting, traveling, or making a late-night run.
        </p>
      </div>

      {# Feature 2 #}
      <div class="rounded-lg border border-zinc-300 bg-zinc-50 p-8 shadow-sm">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg border border-zinc-300 bg-zinc-200 text-zinc-700">
            {% phosphor "shopping-bag-open", "duotone", { size: 30 } %}
          </div>
          <h3 class="text-3xl font-semibold text-zinc-900">Convenience</h3>
        </div>
        <p class="text-lg leading-relaxed text-zinc-700">
          Pick up drinks, snacks, household basics, and everyday essentials without adding another stop to your day. It is a quick, friendly place to stock up and keep moving.
        </p>
      </div>

      {# Feature 3 #}
      <div class="rounded-lg border border-zinc-300 bg-zinc-50 p-8 shadow-sm">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg border border-zinc-300 bg-zinc-200 text-zinc-700">
            {% phosphor "fork-knife", "duotone", { size: 30 } %}
          </div>
          <h3 class="text-3xl font-semibold text-zinc-900">Full Kitchen</h3>
        </div>
        <p class="text-lg leading-relaxed text-zinc-700">
          Food service placeholder copy can go here when the final details are ready.
        </p>
      </div>


   
    </div>
  </div>
</section>



{# Contact Section #}
<section class="page-content section bg-zinc-200 text-zinc-800">
  <div class="mx-auto w-full max-w-6xl px-6 pb-20 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-center">
      <div>
        <h2 class="text-zinc-950">Visit One Dream</h2>
        <div class="mt-6 space-y-5 text-lg text-zinc-700">
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-zinc-900">Address</h3>
            <p class="mt-1">
              6371 NY-167, Dolgeville, NY 13329
            </p>
          </div>

          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-zinc-900">Phone</h3>
            <p class="mt-1">
              <a href="tel:+13154299001" class="text-zinc-700 hover:text-zinc-950 no-underline">(315) 429-9001</a>
            </p>
          </div>

          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-zinc-900">Hours</h3>
            <p class="mt-1">24/7</p>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border border-zinc-300 bg-zinc-100">
        <iframe
          src="https://www.google.com/maps?q=6371%20NY-167%2C%20Dolgeville%2C%20NY%2013329&output=embed"
          title="Map to One Dream at 6371 NY-167, Dolgeville, NY 13329"
          class="h-80 w-full md:h-96"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
